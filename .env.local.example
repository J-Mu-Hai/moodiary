# 本地敏感配置模板：复制为 .env.local 并填入真实值。
# .env.local 已被 .gitignore 排除，不会上传到 GitHub。
# 修改后重新运行 tool/ 下的构建脚本即可生效（构建时会自动拼成 --dart-define）。

# ── WebDAV 同步服务器 ──
MOODIARY_WEBDAV_URL=https://your-webdav-server/
MOODIARY_WEBDAV_USERNAME=your-username
MOODIARY_WEBDAV_PASSWORD=your-password

# ── DeepSeek ──
MOODIARY_DEEPSEEK_KEY=sk-your-api-key
